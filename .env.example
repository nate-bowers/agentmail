NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
# Resend Dashboard -> Webhooks -> your endpoint -> Signing Secret (whsec_...)
RESEND_WEBHOOK_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PRICE_ID=
# STRIPE_UNLIMITED_PRICE_ID=

NEXT_PUBLIC_SITE_URL=

# Optional: Finnhub free-tier API key for live market quotes.
# If unset, markets gracefully falls back to Claude web_search.
# Get a free key at https://finnhub.io
FINNHUB_API_KEY=
CRON_SECRET=
UNSUBSCRIBE_SECRET=

# Optional: where to send ops alerts when the daily-send cron fails.
# Leave unset to disable alerting entirely (no email is sent).
# ALERT_EMAIL=natebowers05@gmail.com

# Sentry (optional — leave blank locally; SDK no-ops when unset).
# Create a project at https://sentry.io -> Settings -> Projects -> Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Only needed in CI/Vercel for source-map uploads on deploy.
# Sentry -> Settings -> Account -> User Auth Tokens (project:releases scope).
SENTRY_AUTH_TOKEN=
